rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function hasActiveProfile() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'volunteer', 'authorized_staff'];
    }
    
    function isValidSize() {
      // Límite de 10 MB por archivo para prevenir saturación de almacenamiento
      return request.resource.size < 10 * 1024 * 1024;
    }

    // Regla por defecto: Denegación de acceso público
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Archivos organizados por módulos
    match /{moduleName}/{recordId}/{fileName} {
      allow read: if hasActiveProfile();
      allow write: if hasActiveProfile() && isValidSize();
    }
  }
}
