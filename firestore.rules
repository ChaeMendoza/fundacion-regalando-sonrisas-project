rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userProfile(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function hasActiveProfile() {
      return isAuthenticated()
        && exists(userProfile(request.auth.uid))
        && get(userProfile(request.auth.uid)).data.status == 'active'
        && get(userProfile(request.auth.uid)).data.role in ['admin', 'volunteer', 'authorized_staff'];
    }

    function isAdmin() {
      return hasActiveProfile()
        && get(userProfile(request.auth.uid)).data.role == 'admin';
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == null
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /beneficiaries/{beneficiaryId} {
      allow read: if hasActiveProfile();
      allow create: if hasActiveProfile() && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasActiveProfile() && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /donations/{donationId} {
      allow read: if hasActiveProfile();
      allow create: if hasActiveProfile() && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasActiveProfile() && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /volunteers/{volunteerId} {
      allow read: if hasActiveProfile();
      allow create: if hasActiveProfile() && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasActiveProfile() && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /activities/{activityId} {
      allow read: if hasActiveProfile();
      allow create: if hasActiveProfile() && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasActiveProfile() && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /documents/{documentId} {
      allow read: if hasActiveProfile();
      allow create: if hasActiveProfile() && request.resource.data.uploadedBy == request.auth.uid;
      allow update: if hasActiveProfile() && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if hasActiveProfile();
      allow create: if hasActiveProfile() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
