# Plantilla de variables locales para operaciones administrativas.
# NO es leída por Angular, Firebase Hosting ni npm automáticamente: el frontend
# no necesita variables de entorno en tiempo de ejecución y el script de bootstrap
# toma estas variables del entorno de la shell. .env está ignorado por Git.

# Correo de la cuenta que se designará como primer administrador.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=

# Solo si el script admin:bootstrap debe crear la cuenta en Authentication.
# Usar un valor temporal y no versionarlo.
INITIAL_ADMIN_PASSWORD=

# Ruta ABSOLUTA a una clave de cuenta de servicio guardada FUERA del repositorio.
# Alternativamente, usar Application Default Credentials de gcloud.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/fuera/del/repo/service-account.json
